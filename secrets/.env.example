# Example environment file. COPY to `.env` and fill in real values.
# `.env` is .gitignored; `.env.example` (this file) is safe to commit because
# it contains NO real secrets — just the shape of what's expected.
#
# Demo point: this is how you share "which variables exist" with teammates
# without ever committing the actual credentials.

# --- SQL Server ---
SQL_SERVER=prod-sqlmi.internal
SQL_DATABASE=YoMomma
SQL_USER=sqladmin
SQL_PASSWORD=

# --- MySQL ---
MYSQL_HOST=127.0.0.1
MYSQL_USER=michael.dspain
MYSQL_PASSWORD=

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/sales

# --- Azure Key Vault (preferred: fetch the above at runtime instead) ---
KEY_VAULT_NAME=kv-passdemo-dev
